{
  "assistant-config-name": "harvest-dvnl-zenodo-folder",
  "description": "Harvest one OAI-PMH dataverse_json record and save final pipeline output to a folder via ACP.",
  "app-name": "harvest-zenodo-jsonfolder",
  "source": {
    "plugin": "oai-pmh",
    "base_url": "https://dataverse.nl/oai",
    "metadata_prefix": "dataverse_json",
    "set_spec": null,
    "mode": "records",
    "deleted_record_policy": "tombstone",
    "timeout_seconds": 60,
    "verify_ssl": true,
    "user_agent": "ORCHESTRATOR-ACP-Harvester/0.1",
    "authentication": null
  },
  "harvesting": {
    "incremental": true,
    "batch_size": 500
  },
  "pipeline": {
    "metadata_type": "application/json",
    "transformer": {
      "name": "dataverse-json-to-zenodo",
      "service_url": "http://mts:1745"
    }
  },
  "targets": [
    {
      "repo-pid": "dv-json-folder",
      "repo-name": "folder-output",
      "repo-display-name": "Folder Output (Dataverse OAI harvest)",
      "bridge-plugin-name": "FolderPipelineDepositor",
      "base-url": "file:///home/akmi/acp/data/output/harvest/dvnl-zenodo",
      "target-url": "file:///home/akmi/acp/data/outputharvest/dvnl-zenodo",
      "username": "",
      "password": "",
      "storage-type": "FILE_SYSTEM",
      "metadata": {
        "specification": [],
        "transformed-metadata": [
          {
            "transformer-url": "http://mts:1745/transform/dataverse-json-to-zenodo-dataset-v1.xsl",
            "name": "zenodo-dataset.json",
            "dir": "final"
          },
          {
            "name": "source-metadata.json",
            "dir": "source"
          }
        ]
      }
    }
  ]
}
