{
  "assistant-config-name": "ssh-harvest-zenodo-sandbox",
  "description": "Harvest DDI2.5 records from SSH Datastations OAI-PMH and deposit to Zenodo sandbox. Requires ddi25-to-zenodo-dataset-v1.xsl to be added to MTS.",
  "app-name": "ssh",
  "source": {
    "plugin": "oai-pmh",
    "base_url": "https://ssh.datastations.nl/oai",
    "metadata_prefix": "oai_ddi25",
    "set_spec": null,
    "mode": "records",
    "deleted_record_policy": "tombstone",
    "timeout_seconds": 60,
    "verify_ssl": true,
    "user_agent": "ORCHESTRATOR-ACP-Harvester/0.1",
    "authentication": null
  },
  "harvesting": {
    "queue_name": "orchestrator-provider",
    "incremental": true,
    "overlap_days": 1,
    "batch_size": 500,
    "maximum_records": null,
    "store_raw_xml": false,
    "validate_metadata_format": true
  },
  "pipeline": {
    "metadata_type": "application/xml",
    "transformer": {
      "name": "ddi25-to-zenodo",
      "service_url": "http://mts:1745"
    }
  },
  "targets": [
    {
      "repo-pid": "ssh-zenodo-sandbox",
      "repo-name": "zenodo-sandbox",
      "repo-display-name": "Zenodo Sandbox (SSH harvest)",
      "bridge-plugin-name": "ZenodoApiDepositor",
      "base-url": "https://sandbox.zenodo.org",
      "target-url": "https://sandbox.zenodo.org/api/deposit/depositions",
      "username": "access_token",
      "password": "",
      "storage-type": "FILE_SYSTEM",
      "metadata": {
        "specification": [],
        "transformed-metadata": [
          {
            "transformer-url": "http://mts:1745/transform/ddi25-to-zenodo-dataset-v1.xsl",
            "name": "zenodo-dataset.json",
            "dir": ""
          }
        ]
      }
    }
  ]
}
