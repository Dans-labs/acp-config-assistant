{
    "name": "odissei-dans-oai",
    "app_name": "odissei",
    "source": {
        "plugin": "oai-pmh",
        "base_url": "https://ssh.datastations.nl/oai",
        "metadata_prefix": "oai_ddi25",
        "set_spec": null,
        "mode": "records",
        "deleted_record_policy": "tombstone",
        "timeout_seconds": 60,
        "verify_ssl": true,
        "user_agent": "ODISSEI-ACP-Harvester/0.1",
        "authentication": null
    },
    "harvesting": {
        "queue_name": "odissei-provider",
        "incremental": true,
        "overlap_days": 1,
        "batch_size": 500,
        "maximum_records": null,
        "store_raw_xml": false,
        "validate_metadata_format": true
    },
    "pipeline": {
        "metadata_type": "application/xml",
        "transformer": {
            "name": "ddi-to-dataverse",
            "service_url": "http://mts:1745"
        }
    },
    "targets": [
        {
            "name": "odissei-dataverse",
            "bridge_plugin_name": "DataverseBridge"
        }
    ]
}