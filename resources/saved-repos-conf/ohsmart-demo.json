{
    "assistant-config-name": "ohsmart-demo",
    "description": "",
    "app-name": "ohsmart-demo",
    "targets": [
        {
	    "repo-pid": "demo",
            "repo-name": "demo.ssh.datastations.nl",
            "repo-display-name": "SSH Datastation",
            "bridge-plugin-name": "DataverseIngester",
            "base-url": "https://demo.ssh.datastations.nl",
            "target-url": "https://demo.ssh.datastations.nl/api/dataverses/root/datasets",
            "username": "API_KEY",
            "password": "",
            "metadata": {
                "specification": [],
                "transformed-metadata": [
                    {
                        "name": "dataset-metadata.json",
                        "transformer-url": "http://mts:1745/transform/ohsmart-form-metadata-to-DV-metadata-vOHCore-v4.xsl",
                        "dir": "metadata"
                    },
                    {
                        "name": "dataset-files.json",
                        "transformer-url": "http://mts:1745/transform/ohsmart-form-metadata-to-DV-files-v2.xsl",
                        "dir": "metadata"
                    },
                    {
                        "name": "__generated__form-metadata-original.json",
                        "mimetype": "application/json",
                        "generate-file":true,
                        "restricted": true
                    },
                    {
                        "name": "__generated__form-metadata-private.json",
                        "transformer-url": "http://mts:1745/transform/ohsmart-form-metadata-to-json-priv-vOHCore-v2.xsl",
                        "generate-file": true,
                        "restricted": true
                    },
                    {
                        "name": "Oral History metadata private.txt",
                        "transformer-url": "http://mts:1745/transform/ohsmart-form-metadata-to-text-priv-vOHCore-v2.xsl",
                        "generate-file": true,
                        "restricted": true
                    },
                    {
                        "name": "__generated__form-metadata-public.json",
                        "transformer-url": "http://mts:1745/transform/ohsmart-form-metadata-to-json-pub-vOHCore-v2.xsl",
                        "generate-file": true,
                        "restricted": false
                    },
                    {
                        "name": "Oral History metadata public.txt",
                        "transformer-url": "http://mts:1745/transform/ohsmart-form-metadata-to-text-pub-vOHCore-v2.xsl",
                        "generate-file": true,
                        "restricted": false
                    }
                ]
            }
        }
    ],
    "file-conversion-url": [
        {
            "origin-type": "mov",
            "target-type": "mp4",
            "conversion-url": "https://"
        },
        {
            "origin-type": "mp4",
            "target-type": "mp3",
            "conversion-url": "https://"
        }
    ]
}
